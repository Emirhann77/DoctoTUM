# Copy to .env.local and fill in values from Supabase:
# Dashboard → Project Settings → API

# Public (safe to expose in the browser; protect data with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Server-only: never commit real values; never expose to the client.
# Optional until you run admin scripts or backend routes that bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct Postgres (optional): Dashboard → Project Settings → Database → Connection string (URI)
# Use for migrations / Prisma / psql — not required for supabase-js in the app.
# DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- FastAPI backend (backend/main.py) — use a root `.env` or export in shell; never commit secrets ---
# Same project URL as above; service role lets the server read `providers` for /api/specialists.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional AI (otherwise mock triage/chat): OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# CORS_ALLOW_ORIGINS=http://127.0.0.1:5500
# Apply migrations with: psql "$DATABASE_URL" -f supabase/migrations/<file>.sql  (in filename order)
# Keyless local development only: serve every request as one demo user from the in-memory store.
# Ignored as soon as SUPABASE_URL or SUPABASE_JWT_SECRET is set.
# CARECONNECT_ALLOW_DEMO_USER=1
# Written by `python -m backend.scripts.seed_demo` (test account for browser and live tests):
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# JWT secret for verifying Supabase tokens in FastAPI (only for projects that still sign with HS256;
# newer projects sign with ES256 and are verified against the project's published keys automatically): Dashboard → Project Settings → API → JWT Secret
# SUPABASE_JWT_SECRET=your_jwt_secret_here
